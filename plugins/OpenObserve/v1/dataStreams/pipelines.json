{
    "name": "pipelines",
    "displayName": "Pipelines",
    "description": "Data transformation pipelines defined in the organization",
    "tags": ["Pipelines"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "pipelines",
        "postRequestScript": "pipelines.js"
    },
    "matches": "none",
    "metadata": [
        { "name": "pipeline_id", "displayName": "Pipeline ID", "shape": "string" },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "enabled", "displayName": "Enabled", "shape": "boolean" },
        { "name": "version", "displayName": "Version", "shape": "number" },
        { "name": "paused_at", "displayName": "Paused At", "shape": "number" },
        { "name": "last_error", "displayName": "Last Error", "shape": "json" },
        { "name": "source", "displayName": "Source", "shape": "json" },
        { "name": "nodeCount", "displayName": "Node Count", "shape": "number" },
        { "name": "edgeCount", "displayName": "Edge Count", "shape": "number" }
    ],
    "timeframes": false
}

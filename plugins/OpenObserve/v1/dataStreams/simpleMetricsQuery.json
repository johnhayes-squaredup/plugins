{
    "name": "simpleMetricsQuery",
    "displayName": "Simple Metrics Query",
    "description": "Time series data for a metric, built from a guided metric/label/value picker",
    "tags": [
        "Metrics"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "prometheus/api/v1/query_range",
        "getArgs": [
            {
                "key": "query",
                "value": "{{ (aggregation && aggregation !== 'none' ? aggregation + '(' : '') + metric + (label && values && values.length ? '{' + label + '=~\"' + values.join('|') + '\"}' : '') + (aggregation && aggregation !== 'none' ? ')' : '') }}"
            },
            {
                "key": "start",
                "value": "{{timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{timeframe.unixEnd}}"
            },
            {
                "key": "step",
                "value": "{{step || '60s'}}"
            }
        ],
        "postRequestScript": "metricsQuery.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "autocomplete",
            "name": "metric",
            "label": "Metric",
            "allowCustomValues": false,
            "isMulti": false,
            "validation": {
                "required": true
            },
            "data": {
                "source": "dataStream",
                "dataStreamName": "metricNames",
                "dataSourceConfig": {}
            }
        },
        {
            "type": "autocomplete",
            "name": "label",
            "label": "Filter by label",
            "allowCustomValues": false,
            "isMulti": false,
            "data": {
                "source": "dataStream",
                "dataStreamName": "metricLabels",
                "dataSourceConfig": {
                    "metric": {
                        "fieldName": "metric",
                        "required": true
                    }
                }
            }
        },
        {
            "type": "autocomplete",
            "name": "values",
            "label": "Values",
            "allowCustomValues": false,
            "isMulti": true,
            "data": {
                "source": "dataStream",
                "dataStreamName": "labelValues",
                "dataSourceConfig": {
                    "metric": {
                        "fieldName": "metric",
                        "required": true
                    },
                    "labelName": {
                        "fieldName": "label",
                        "required": true
                    }
                }
            }
        },
        {
            "type": "autocomplete",
            "name": "aggregation",
            "label": "Aggregation",
            "allowCustomValues": false,
            "isMulti": false,
            "defaultValue": "none",
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "value": "none",
                        "label": "None"
                    },
                    {
                        "value": "sum",
                        "label": "Sum"
                    },
                    {
                        "value": "avg",
                        "label": "Average"
                    },
                    {
                        "value": "min",
                        "label": "Minimum"
                    },
                    {
                        "value": "max",
                        "label": "Maximum"
                    },
                    {
                        "value": "count",
                        "label": "Count"
                    }
                ]
            }
        },
        {
            "type": "text",
            "name": "step",
            "label": "Step (e.g. 60s, 5m)",
            "defaultValue": "60s"
        }
    ],
    "metadata": [
        {
            "name": "labels",
            "displayName": "Labels",
            "shape": "string"
        },
        {
            "name": "timestamp",
            "displayName": "Timestamp",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": "number"
        }
    ],
    "timeframes": true
}
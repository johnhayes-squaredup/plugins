{
    "name": "streamFieldValues",
    "displayName": "Stream Field Values",
    "description": "Top values for chosen fields in a stream",
    "tags": ["Search"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "{{object.name}}/_values",
        "getArgs": [
            { "key": "fields", "value": "{{fields}}" },
            { "key": "type", "value": "{{object.stream_type}}" },
            { "key": "start_time", "value": "{{timeframe.unixStart * 1000000}}" },
            { "key": "end_time", "value": "{{timeframe.unixEnd * 1000000}}" },
            { "key": "size", "value": "{{size || null}}" },
            { "key": "keyword", "value": "{{keyword || null}}" },
            { "key": "no_count", "value": "{{no_count ? 'true' : 'false'}}" }
        ],
        "postRequestScript": "streamFieldValues.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["OpenObserve Stream"] } },
    "ui": [
        {
            "type": "text",
            "name": "fields",
            "label": "Fields",
            "placeholder": "field1,field2",
            "validation": { "required": true }
        },
        {
            "type": "number",
            "name": "size",
            "label": "Max values per field",
            "defaultValue": 10
        },
        {
            "type": "text",
            "name": "keyword",
            "label": "Filter keyword (optional)"
        },
        {
            "type": "checkbox",
            "name": "no_count",
            "label": "Order by value instead of count"
        }
    ],
    "metadata": [
        { "name": "field", "displayName": "Field", "shape": "string" },
        { "name": "value", "displayName": "Value", "shape": "string", "role": "label" },
        { "name": "count", "displayName": "Count", "shape": "number" }
    ],
    "timeframes": true
}

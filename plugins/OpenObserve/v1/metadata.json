{
    "name": "openobserve",
    "displayName": "OpenObserve",
    "version": "1.0.0",
    "author": {
        "name": "SquaredUp Labs",
        "type": "labs"
    },
    "description": "Monitor streams, run log search, and check functions and cluster health in your OpenObserve Cloud organization.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["observability", "logs", "log search", "openobserve"],
    "objectTypes": ["OpenObserve Stream"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/OpenObserve/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/OpenObserve/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{region}}/api/{{organization}}",
            "authMode": "none",
            "headers": [
                { "key": "Authorization", "value": "Basic {{key}}" }
            ],
            "queryArgs": []
        }
    }
}
